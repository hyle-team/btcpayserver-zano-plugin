@model BTCPayServer.Models.InvoicingModels.CheckoutModel

@*
    Secondary "Open in Cake Wallet" button for Zano invoices. The QR code uses
    the BIP21 form (set in ZanoCheckoutModelExtension), which is exactly what
    Cake Wallet parses, so we link to that URL directly. The primary button
    above uses the canonical Zano deeplink for the official wallets.
*@

<a v-if="model.invoiceBitcoinUrl && model.invoiceBitcoinUrl.indexOf('zano:action=send') === 0"
   class="btn btn-outline-primary rounded-pill w-100 mt-2"
   target="_blank"
   :href="model.invoiceBitcoinUrlQR"
   title="Cake Wallet (Monero-style BIP21)">
    Open in Cake Wallet
</a>
